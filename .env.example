# Copy to `.env.local` (git-ignored) for local work, and set the same variables in
# the Vercel project settings for deploys.

# ── /lien-he enquiry form ────────────────────────────────────────────────────
# Where a submitted form is POSTed, as JSON. Deliberately transport-agnostic:
# Formspree, Web3Forms, a Slack or Discord incoming webhook, an n8n / Make flow,
# a Google Apps Script, or your own API all accept a JSON POST, so going live is
# one env var rather than a code change.
#
# LEAVE IT UNSET AND THE FORM DOES NOT PRETEND TO SEND. It validates, then tells
# the visitor plainly that the channel isn't connected — it never shows a green
# tick over a message that went nowhere. See `src/app/lien-he/actions.ts`.
CONTACT_WEBHOOK_URL=

# Optional. Sent as `Authorization: Bearer <token>` with the request above; only
# needed if your endpoint checks it.
CONTACT_WEBHOOK_TOKEN=

# ── /ung-tuyen application form ──────────────────────────────────────────────
# Same contract, separate inbox. Applications carry a CV link and personal
# details, so they usually belong somewhere the general enquiry channel doesn't
# go — an ATS, HR's own flow, a private Slack channel.
#
# BOTH ARE OPTIONAL: with them unset, applications fall back to the CONTACT pair
# above, so one inbox needs one variable. With NEITHER set, the form does not
# pretend to send — see `src/app/ung-tuyen/actions.ts`.
CAREERS_WEBHOOK_URL=
CAREERS_WEBHOOK_TOKEN=
